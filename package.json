{
  "name": "amana",
  "version": "0.1.0",
  "description": "Portable private credit history on Midnight. Prove a repayment record you earned at one lender to another, without revealing who, how much, or that it was you.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "workspaces": [
    "contract",
    "api",
    "amana-ui"
  ],
  "scripts": {
    "compact": "npm run compact --workspace=contract",
    "compact:check": "npm run compact:check --workspace=contract",
    "build": "npm run build --workspace=contract && npm run build --workspace=api && npm run build --workspace=amana-ui",
    "test": "npm run test --workspace=contract && npm run test --workspace=api && npm run test --workspace=amana-ui && npm run test:scripts",
    "test:scripts": "node --test scripts/onchain-checks.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ui": "npm run dev --workspace=amana-ui",
    "verify:onchain": "node scripts/verify-onchain.mjs",
    "ci": "npm run compact && npm run typecheck && npm test && npm run build",
    "evidence:wallet": "node scripts/evidence/fund.mjs",
    "evidence": "node scripts/evidence/run.mjs",
    "evidence:record": "node scripts/evidence/record.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/dapp-connector-api": "4.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnight-ntwrk/wallet-sdk": "2.0.1",
    "buffer": "^6.0.3",
    "fp-ts": "^2.16.11",
    "pino": "^10.3.1",
    "rxjs": "^7.8.2",
    "semver": "^7.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "resolutions": {
    "@midnight-ntwrk/wallet-sdk": "2.0.1"
  },
  "overrides": {
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/onchain-runtime-v4": "4.0.2"
  }
}
