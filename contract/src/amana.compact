pragma language_version 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Amana lets a borrower prove a repayment record they earned at one lender to
// a different lender, without revealing which lenders they borrowed from, how
// much they borrowed, or that any two records belong to the same person.
//
// The split between the two ledgers is the whole product:
//
//   public  — which institutions may issue, a Merkle root over every issued
//             attestation, spent nullifiers, and answered checks.
//   private — counts, reporting intervals, borrower key and lender selection.
//             Witnesses are processed by the participant's configured prover.
//
// The public result records the requested threshold and interval, plus a
// check-specific nullifier. Actual repayment counts remain private.
// ---------------------------------------------------------------------------

/**
 * A single lender's account of how a borrower repaid them.
 *
 * This structure is *never* published. It lives in the borrower's private
 * state; the ledger only ever stores `persistentHash<Attestation>` of it.
 */
export struct Attestation {
  // Registry key of the issuing lender.
  lender: Bytes<32>;
  // The borrower's pseudonym *at this lender specifically* — see `subjectId`.
  subject: Bytes<32>;
  // Repayments made on or before their due date.
  onTime: Uint<16>;
  // Total repayments scheduled in this reporting interval.
  total: Uint<16>;
  // Inclusive month indices since 1970-01. Counts cover this entire interval.
  periodStart: Uint<32>;
  periodEnd: Uint<32>;
  // Blinding factor, so two identical records do not collide in the tree.
  nonce: Bytes<32>;
}

/**
 * What a verifier reads back after a borrower answers their check. It records
 * the bar that was cleared — never the margin by which it was cleared.
 */
export struct CheckResult {
  minOnTime: Uint<16>;
  minPeriod: Uint<32>;
  maxPeriod: Uint<32>;
  nullifier: Bytes<32>;
}

/** Immutable, verifier-created terms and a check-specific holder binding. */
export struct CheckTerms {
  verifier: Bytes<32>;
  recipient: Bytes<32>;
  minOnTime: Uint<16>;
  minPeriod: Uint<32>;
  maxPeriod: Uint<32>;
}

// --- public ledger ---------------------------------------------------------

export ledger protocolVersion: Uint<8>;

// The registry operator, established once by whoever deploys the contract.
export ledger authority: Bytes<32>;
export ledger bootstrapped: Boolean;

// Institutions permitted to issue attestations.
export ledger lenders: Set<Bytes<32>>;

// Commitments to every attestation ever issued.
//
// Deliberately a plain MerkleTree and NOT a HistoricMerkleTree: `checkRoot`
// must accept the *current* root only. That is what makes revocation work —
// see `revokeAttestation`.
export ledger attestations: MerkleTree<10, Bytes<32>>;

// Leaf index -> issuing lender, so only the issuer can revoke what it issued.
// This reveals which institution filled a slot, never who the borrower is.
export ledger issuers: Map<Uint<64>, Bytes<32>>;

// Next leaf to fill. Held in the ledger because a circuit cannot read
// `firstFree()` — that is a TypeScript-side query.
export ledger nextLeaf: Counter;

// Spent proof nullifiers; stops a borrower answering the same check twice.
export ledger nullifiers: Set<Bytes<32>>;

// checkId -> the bar that was cleared.
export ledger checks: Map<Bytes<32>, CheckResult>;

// Requests exist before proofs. There is no edit or deletion circuit.
export ledger requestedChecks: Map<Bytes<32>, CheckTerms>;

// Public counters, so the network's health is legible without leaking anyone.
export ledger issuedCount: Counter;
export ledger revokedCount: Counter;
export ledger acceptedCount: Counter;

constructor(initialAuthority: Bytes<32>) {
  protocolVersion = 2;
  assert(initialAuthority != default<Bytes<32>>, "authority key must not be zero");
  authority = disclose(initialAuthority);
  bootstrapped = false;
}

// --- private state ---------------------------------------------------------

// The caller's identity key. One witness, two roles: a lender's key
// authorises issuance, a borrower's key binds attestations to them.
witness localSecretKey(): Bytes<32>;

// The attestation a lender is about to issue. Passing it as a witness rather
// than a parameter keeps repayment counts and intervals off chain at issuance.
witness pendingAttestation(): Attestation;

// The borrower's wallet: up to four records, their Merkle paths, and which
// slots actually carry a record.
witness heldAttestations(): Vector<4, Attestation>;
witness heldPaths(): Vector<4, MerkleTreePath<10, Bytes<32>>>;
witness heldUsed(): Vector<4, Boolean>;

// --- key derivation --------------------------------------------------------

/** A lender's public registry key. */
export pure circuit lenderKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "amana:lender:"), sk]);
}

/** A verifier's key is not their public lender key, even on the same device. */
export pure circuit verifierKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "amana:verifier:"), sk]);
}

/** The nonce and verifier key establish ownership of the request identifier. */
export pure circuit requestId(verifier: Bytes<32>, nonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "amana:check:v2:"), verifier, nonce]);
}

/** The borrower sends this response key to the verifier before registration. */
export pure circuit checkRecipient(sk: Bytes<32>, checkId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "amana:recipient:"), sk, checkId]);
}

/**
 * The borrower's pseudonym at one specific lender.
 *
 * Because the lender's key is mixed in, the same borrower presents an
 * unrelatable identifier to every institution they deal with. Two lenders
 * comparing their books cannot tell they share a customer — and yet the proof
 * circuit, which knows the secret, can still gather those records into one
 * total. That is the property the whole design exists to deliver.
 */
export pure circuit subjectId(sk: Bytes<32>, lender: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "amana:subject:"), sk, lender]);
}

/** The nullifier a borrower burns when answering a given check. */
export pure circuit checkNullifier(sk: Bytes<32>, checkId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "amana:nullifier:"), sk, checkId]);
}

/** The leaf committed to the tree for an attestation. */
export pure circuit attestationCommitment(a: Attestation): Bytes<32> {
  return persistentHash<Attestation>(a);
}

/** Shared with the client so exact-index liveness uses the circuit's hash. */
export pure circuit attestationPathRoot(path: MerkleTreePath<10, Bytes<32>>): MerkleTreeDigest {
  return merkleTreePathRoot<10, Bytes<32>>(path);
}

/** An attestation's contribution to the total, or zero if the slot is empty. */
export pure circuit slotOnTime(a: Attestation, used: Boolean): Uint<32> {
  if (used) {
    return a.onTime as Uint<32>;
  } else {
    return 0 as Uint<32>;
  }
}

// --- registry --------------------------------------------------------------

/**
 * Activate the registry with the key committed during deployment.
 * Knowing the contract address does not allow a stranger to claim it first.
 */
export circuit claimAuthority(): [] {
  assert(!bootstrapped, "registry already has an authority");
  assert(authority == disclose(lenderKey(localSecretKey())), "only the deployment authority may activate the registry");
  bootstrapped = true;
}

/** Admit an institution to the set permitted to issue attestations. */
export circuit registerLender(lender: Bytes<32>): [] {
  assert(bootstrapped, "registry has no authority yet");
  assert(authority == disclose(lenderKey(localSecretKey())), "only the authority may register lenders");
  lenders.insert(disclose(lender));
}

// --- issuance --------------------------------------------------------------

/**
 * Issue an attestation to a borrower.
 *
 * The record itself arrives as a witness, so the chain sees only its hash.
 * The circuit still enforces what it can see privately: that the record is
 * bound to the lender signing it, and that the on-time count is not inflated
 * past the number of repayments that were actually scheduled.
 */
export circuit issueAttestation(): Uint<64> {
  const key = lenderKey(localSecretKey());
  const a = pendingAttestation();

  assert(lenders.member(disclose(key)), "not a registered lender");
  assert(a.lender == key, "attestation is not bound to the issuing lender");
  assert(a.onTime <= a.total, "on-time repayments exceed total repayments");
  assert(a.periodStart <= a.periodEnd, "invalid reporting interval");

  const index = nextLeaf as Uint<64>;
  assert(index < 1024, "registry is full");
  attestations.insertIndex(disclose(attestationCommitment(a)), disclose(index));
  issuers.insert(disclose(index), disclose(key));
  nextLeaf.increment(1);
  issuedCount.increment(1);
  return disclose(index);
}

/**
 * Void a previously issued attestation.
 *
 * Overwriting the leaf with the default value changes the tree's root, so
 * every path that ran through that leaf stops verifying. Because the tree is
 * not historic, the old root is not accepted either. The borrower's proof
 * simply stops succeeding — no revocation list is consulted, and no
 * additional information about the borrower reaches the chain.
 */
export circuit revokeAttestation(index: Uint<64>): [] {
  const key = lenderKey(localSecretKey());
  assert(lenders.member(disclose(key)), "not a registered lender");
  assert(issuers.member(disclose(index)), "no attestation at that index");
  assert(issuers.lookup(disclose(index)) == disclose(key), "only the issuing lender may revoke");

  attestations.insertIndexDefault(disclose(index));
  issuers.remove(disclose(index));
  revokedCount.increment(1);
}

// --- verifier requests -----------------------------------------------------

export circuit createCheck(
  checkId: Bytes<32>,
  nonce: Bytes<32>,
  recipient: Bytes<32>,
  minOnTime: Uint<16>,
  minPeriod: Uint<32>,
  maxPeriod: Uint<32>
): [] {
  assert(bootstrapped, "registry has no authority yet");
  const key = verifierKey(localSecretKey());
  assert(checkId == requestId(key, nonce), "check identifier is not owned by this verifier");
  assert(!requestedChecks.member(disclose(checkId)), "check already exists");
  assert(recipient != default<Bytes<32>>, "recipient key must not be zero");
  assert(minOnTime > 0, "repayment threshold must be positive");
  assert(minPeriod <= maxPeriod, "invalid check window");
  requestedChecks.insert(disclose(checkId), CheckTerms {
    verifier: disclose(key),
    recipient: disclose(recipient),
    minOnTime: disclose(minOnTime),
    minPeriod: disclose(minPeriod),
    maxPeriod: disclose(maxPeriod)
  });
}

// --- the proof -------------------------------------------------------------

/**
 * Prove a credit standing to a verifier.
 *
 * The borrower answers a `checkId` the verifier handed them out of band, and
 * proves the committed terms. Each summary's entire reporting interval must
 * lie inside the requested inclusive window; at most one summary per lender
 * can contribute. The issuer is trusted to state the underlying facts.
 *
 * What the chain learns: that some holder of some set of valid attestations
 * cleared this bar, and a nullifier that is unlinkable to any other check.
 *
 * What the chain does not learn: which lenders issued the records, how many
 * records there were, how much was borrowed, the actual on-time total, or
 * anything that ties this answer to another answer by the same person.
 */
export circuit proveCreditStanding(checkId: Bytes<32>): [] {
  assert(requestedChecks.member(disclose(checkId)), "check does not exist");
  assert(!checks.member(disclose(checkId)), "check has already been answered");
  const terms = requestedChecks.lookup(disclose(checkId));

  const sk = localSecretKey();
  assert(terms.recipient == disclose(checkRecipient(sk, checkId)), "check is for a different borrower");
  const atts = heldAttestations();
  const paths = heldPaths();
  const used = heldUsed();

  // Uint<32> safely holds four Uint<16> contributions. Fail empty proofs before
  // accessing their padding paths; every successful proof has a real filler.
  const t0 = slotOnTime(atts[0], used[0]);
  const t1 = (t0 + slotOnTime(atts[1], used[1])) as Uint<32>;
  const t2 = (t1 + slotOnTime(atts[2], used[2])) as Uint<32>;
  const t3 = (t2 + slotOnTime(atts[3], used[3])) as Uint<32>;
  assert(t3 >= terms.minOnTime as Uint<32>, "insufficient on-time repayments");

  for (const i of 0..4) {
    const a = atts[i];
    const u = used[i];

    // The record was issued to *this* borrower, under this lender's pseudonym.
    assert(!u || a.subject == subjectId(sk, a.lender),
      "attestation was not issued to this borrower");

    // A lender cannot have counted more on-time repayments than existed.
    assert(!u || a.onTime <= a.total, "malformed attestation");

    // A recent final repayment cannot bring older counts into the window.
    assert(!u || a.periodStart <= a.periodEnd, "invalid reporting interval");
    assert(!u || (a.periodStart >= terms.minPeriod && a.periodEnd <= terms.maxPeriod),
      "attestation is outside the check window");

    // The path opens to exactly this record...
    assert(!u || paths[i].leaf == attestationCommitment(a),
      "merkle path does not open to the attestation");

    // ...and that leaf is live in the registry right now. A revoked leaf, or
    // a record that was never issued, fails here.
    //
    // Note the argument order. Written `!u || checkRoot(...)`, the short
    // circuit would make a *ledger operation* conditional on `u`, and the
    // compiler rejects that as a disclosure — correctly, because it would
    // leak how many attestations this borrower actually holds. Evaluating
    // `checkRoot` first keeps the number of ledger reads identical for every
    // borrower. Unused slots carry a duplicate of a live path (see the
    // witness provider), so the disclosed root is the tree's real root in all
    // four slots and distinguishes nothing.
    assert(attestations.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(paths[i]))),
      "attestation is not live in the registry");
  }

  // One summary per lender: reissuing a cumulative snapshot with a new nonce
  // cannot cause the same lender's repayments to contribute twice.
  assert(!(used[0] && used[1]) || atts[0].lender != atts[1].lender, "multiple summaries from one lender");
  assert(!(used[0] && used[2]) || atts[0].lender != atts[2].lender, "multiple summaries from one lender");
  assert(!(used[0] && used[3]) || atts[0].lender != atts[3].lender, "multiple summaries from one lender");
  assert(!(used[1] && used[2]) || atts[1].lender != atts[2].lender, "multiple summaries from one lender");
  assert(!(used[1] && used[3]) || atts[1].lender != atts[3].lender, "multiple summaries from one lender");
  assert(!(used[2] && used[3]) || atts[2].lender != atts[3].lender, "multiple summaries from one lender");

  // Burn a nullifier bound to this borrower and this check. It reveals
  // nothing about who they are, and cannot be linked to the nullifier they
  // would burn for any other check.
  const nul = checkNullifier(sk, checkId);
  assert(!nullifiers.member(disclose(nul)), "this borrower has already answered this check");
  nullifiers.insert(disclose(nul));

  // The thresholds are the verifier's own published terms, so recording them
  // discloses nothing the verifier did not choose. The margin above the
  // threshold is never written.
  checks.insert(disclose(checkId), CheckResult {
    minOnTime: terms.minOnTime,
    minPeriod: terms.minPeriod,
    maxPeriod: terms.maxPeriod,
    nullifier: disclose(nul)
  });
  acceptedCount.increment(1);
}
