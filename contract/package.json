  "scripts": {
    "compact": "node ../scripts/compile.mjs",
    "compact:check": "node ../scripts/compile.mjs --skip-zk",
    "build": "node ../scripts/build-workspace.mjs contract",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
